import { vehicles } from './data.js';

// ---- VARIABILI E DOM ----
const catalogGrid = document.getElementById('catalog-grid');
const favGrid = document.getElementById('favorites-grid');
const resultsCount = document.getElementById('results-count');
const searchInput = document.getElementById('search-input');
const categoryFilter = document.getElementById('category-filter');
const sortSelect = document.getElementById('sort-select');
const resetBtn = document.getElementById('reset-btn');
const emptyFavMsg = document.getElementById('favorites-empty');
const toastContainer = document.getElementById('toast-container');

let favorites = JSON.parse(localStorage.getItem('camper_favs')) || [];

// ---- TOASTS ----
const showToast = (message) => {
  const toast = document.createElement('div');
  toast.className = 'toast';
  toast.textContent = message;
  toastContainer.appendChild(toast);
  setTimeout(() => toast.remove(), 3000);
};

// ---- RENDERING CARD ----
const createCard = (camper, isFavPage = false) => {
  const isFav = favorites.includes(camper.id);
  const div = document.createElement('div');
  div.className = 'vehicle-card';
  div.innerHTML = `
    <img src="${camper.image}" alt="${camper.name}">
    <div class="card-content">
      <h3>${camper.name}</h3>
      <p>Categoria: ${camper.category.toUpperCase()}</p>
      <p class="price">€ ${camper.price.toLocaleString('it-IT')}</p>
      <div class="card-actions">
        <button class="btn btn-primary btn-details" data-id="${camper.id}">Dettagli</button>
        <button class="btn btn-secondary btn-fav" data-id="${camper.id}">
          ${isFav ? 'Rimuovi ❤️' : 'Salva 🤍'}
        </button>
      </div>
    </div>
  `;
  return div;
};

// ---- GESTIONE CATALOGO E FILTRI ----
const renderCatalog = () => {
  let filtered = [...vehicles];
  const term = searchInput.value.toLowerCase();
  const cat = categoryFilter.value;
  const sort = sortSelect.value;

  // Filtri
  if (term) filtered = filtered.filter(v => v.name.toLowerCase().includes(term) || v.brand.toLowerCase().includes(term));
  if (cat !== 'all') filtered = filtered.filter(v => v.category === cat);

  // Ordinamento
  filtered.sort((a, b) => {
    if (sort === 'name-asc') return a.name.localeCompare(b.name);
    if (sort === 'price-asc') return a.price - b.price;
    if (sort === 'price-desc') return b.price - a.price;
    return 0;
  });

  catalogGrid.innerHTML = '';
  filtered.forEach(c => catalogGrid.appendChild(createCard(c)));
  resultsCount.textContent = filtered.length;
  renderFavorites();
};

const renderFavorites = () => {
  favGrid.innerHTML = '';
  const favVehicles = vehicles.filter(v => favorites.includes(v.id));
  if (favVehicles.length === 0) {
    emptyFavMsg.style.display = 'block';
  } else {
    emptyFavMsg.style.display = 'none';
    favVehicles.forEach(c => favGrid.appendChild(createCard(c, true)));
  }
};

// ---- EVENT LISTENERS FILTRI E RESET ----
searchInput.addEventListener('input', renderCatalog);
categoryFilter.addEventListener('change', renderCatalog);
sortSelect.addEventListener('change', renderCatalog);

resetBtn.addEventListener('click', () => {
  searchInput.value = '';
  categoryFilter.value = 'all';
  sortSelect.value = 'name-asc';
  renderCatalog();
});

// ---- DELEGAZIONE EVENTI (Dettagli e Preferiti) ----
document.addEventListener('click', (e) => {
  if (e.target.classList.contains('btn-fav')) {
    const id = parseInt(e.target.dataset.id);
    if (favorites.includes(id)) {
      favorites = favorites.filter(favId => favId !== id);
      showToast('Rimosso dai preferiti');
    } else {
      favorites.push(id);
      showToast('Aggiunto ai preferiti!');
    }
    localStorage.setItem('camper_favs', JSON.stringify(favorites));
    renderCatalog();
  }

  if (e.target.classList.contains('btn-details')) {
    openModal(parseInt(e.target.dataset.id));
  }
});

// ---- MODALE ----
const modalOverlay = document.getElementById('modal-overlay');
const modalContent = document.getElementById('modal-content');

const openModal = (id) => {
  const camper = vehicles.find(v => v.id === id);
  if (!camper) return;
  modalContent.innerHTML = `
    <h2>${camper.name}</h2>
    <p><strong>Marca:</strong> ${camper.brand} | <strong>Anno:</strong> ${camper.year}</p>
    <p><strong>Posti Letto:</strong> ${camper.beds}</p>
    <img src="${camper.image}" alt="${camper.name}" style="width:100%; border-radius:8px; margin: 15px 0;">
    <p>${camper.description}</p>
    <h3 style="color:var(--accent); margin-top:15px;">€ ${camper.price.toLocaleString('it-IT')}</h3>
  `;
  modalOverlay.classList.remove('hidden');
};

const closeModal = () => modalOverlay.classList.add('hidden');
document.getElementById('modal-close').addEventListener('click', closeModal);
modalOverlay.addEventListener('click', (e) => { if(e.target === modalOverlay) closeModal(); });
document.addEventListener('keydown', (e) => { if(e.key === 'Escape') closeModal(); });

// ---- VALIDAZIONE FORM CONTATTI ----
const form = document.getElementById('contact-form');
form.addEventListener('submit', (e) => {
  e.preventDefault();
  let isValid = true;

  const name = document.getElementById('input-name');
  const email = document.getElementById('input-email');
  const msg = document.getElementById('input-message');

  const showError = (input, show) => {
    input.classList.toggle('invalid', show);
    input.nextElementSibling.style.display = show ? 'block' : 'none';
  };

  if (name.value.trim().length < 2) { showError(name, true); isValid = false; } else showError(name, false);
  if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email.value)) { showError(email, true); isValid = false; } else showError(email, false);
  if (msg.value.trim().length < 10) { showError(msg, true); isValid = false; } else showError(msg, false);

  if (isValid) {
    showToast('Messaggio inviato con successo!');
    form.reset();
  }
});

// ---- TEMA DARK/LIGHT ----
const themeBtn = document.getElementById('theme-toggle');
if (localStorage.getItem('camper_theme') === 'dark') document.body.classList.add('dark-mode');

themeBtn.addEventListener('click', () => {
  document.body.classList.toggle('dark-mode');
  const isDark = document.body.classList.contains('dark-mode');
  localStorage.setItem('camper_theme', isDark ? 'dark' : 'light');
});

// ---- MENU HAMBURGER ----
document.getElementById('hamburger-btn').addEventListener('click', () => {
  document.getElementById('main-nav').classList.toggle('nav-open');
});

// Init
renderCatalog();
document.getElementById('footer-year').textContent = new Date().getFullYear();